# ---------------------------------------------------------------- secrets (never commit)
# App signing key. Whoever has it can sign an APK that installs as an "update" to your app.
# Keep it on your PC (and a backup); GitHub Actions gets it from a repository secret instead.
keystore/
*.keystore
*.jks
keystore.properties
signing.properties

# ---------------------------------------------------------------- personal data (never commit)
# Your real bank SMS, used only by the local parser tests.
samples.txt
samples*.txt
!core/src/test/resources/samples-example.txt
