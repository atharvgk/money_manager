<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Lets tools/send-sms.ps1 feed back-dated SMS to the app on the emulator.
     android.permission.DUMP is held only by adb/system, so no app on a phone can trigger it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.FakeSmsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
